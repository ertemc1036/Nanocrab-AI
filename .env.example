# Copy to .env.local and fill in. Never commit real values.
# Variables are introduced phase by phase; unused ones are ignored until then.

# --- Supabase (Phase 2) ---------------------------------------------------
# Project Settings → API. The publishable (anon) key is safe for the browser;
# all data access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public base URL, used for auth email redirects (e.g. http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Anthropic (Phase 4) — server only, never prefix with NEXT_PUBLIC_ -------
ANTHROPIC_API_KEY=

# --- Cost controls (Phase 4–5) ----------------------------------------------
# AI_MAX_OUTPUT_TOKENS=1024
# AI_DAILY_MESSAGE_LIMIT=100
