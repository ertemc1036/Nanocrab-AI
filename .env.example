# Copy to .env.local and fill in. Never commit real values.
# See docs/SUPABASE_SETUP.md.

# --- Supabase (Phase 2) ---------------------------------------------------
# Project Settings → API. The publishable key (sb_publishable_…, formerly
# "anon") is safe for the browser; all data access is protected by RLS.
# Do NOT use the service-role / secret key — the app doesn't need it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base URL used in auth email links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Anthropic (Phase 4) — server only, never prefix with NEXT_PUBLIC_ -------
ANTHROPIC_API_KEY=

# --- Cost controls (Phase 4–5) ----------------------------------------------
# AI_MAX_OUTPUT_TOKENS=1024
# AI_DAILY_MESSAGE_LIMIT=100
