# Copy to .env.local and fill in. Never commit real values.
# See docs/SUPABASE_SETUP.md and docs/AI.md.

# --- Supabase ---------------------------------------------------------------
# Project Settings → API. The publishable key (sb_publishable_…, formerly
# "anon") is safe for the browser; all data access is protected by RLS.
# Do NOT use the service-role / secret key — the app doesn't need it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base URL used in auth email links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OpenAI (server only — never prefix with NEXT_PUBLIC_) -------------------
# Without a key, AI features show a "not configured" state; everything else works.
OPENAI_API_KEY=
# Any Responses API text model. Default: gpt-5.4-mini.
OPENAI_MODEL=gpt-5.4-mini
# USD per 1M tokens for OPENAI_MODEL. Used for spending limits — keep in sync
# with https://openai.com/api/pricing when you change the model.
OPENAI_PRICE_INPUT_PER_1M=0.75
OPENAI_PRICE_OUTPUT_PER_1M=4.50

# --- AI cost and abuse controls (defaults shown) -----------------------------
# AI_MAX_OUTPUT_TOKENS=1200        # per chat reply
# AI_MAX_INPUT_CHARS=4000          # per user message
# AI_CONTEXT_TOKEN_BUDGET=6000     # workspace context and history, each
# AI_REQUESTS_PER_MINUTE=5         # per user (database ceiling: 30)
# AI_REQUESTS_PER_DAY=100          # per user (database ceiling: 500)
# AI_MONTHLY_SPEND_LIMIT_USD=2     # per user (database ceiling: 50)
# AI_GLOBAL_DAILY_SPEND_LIMIT_USD=10  # all users combined
# AI_REQUEST_TIMEOUT_MS=60000
